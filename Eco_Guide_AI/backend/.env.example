# ─────────────────────────────────────────────────────────────
#  WildGuard AI – Environment Configuration
# ─────────────────────────────────────────────────────────────

# REQUIRED: Google Gemini API Key (https://ai.google.dev)
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: Preferred Gemini model
GEMINI_MODEL=gemini-2.0-flash

# OPTIONAL: IUCN Red List API token (https://apiv3.iucnredlist.org/api/v3/token)
IUCN_API_TOKEN=

# OPTIONAL: GBIF API (no token required for basic access)
GBIF_BASE_URL=https://api.gbif.org/v1

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
CORS_ORIGINS=*
